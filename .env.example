# Copy to .env and fill in. Never commit .env.

# Password for the app itself (required if the server is reachable from your phone).
STOA_PASSWORD=choose-a-long-passphrase
# The URL you open the app at. Used for cookies and the Google redirect.
STOA_PUBLIC_URL=http://localhost:8000
STOA_TIMEZONE=America/New_York
# Where the SQLite database and tokens live. Back this folder up.
# STOA_DATA_DIR=./data

# Garmin: optional. You can instead sign in from Settings (needed if you use 2-step verification).
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Hour (local time) of the morning pull. Two more pulls run 7 and 15 hours later.
GARMIN_SYNC_HOUR=6

# Google Calendar (see README: "Connect Google Calendar").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to $STOA_PUBLIC_URL/api/google/callback
# GOOGLE_REDIRECT_URI=
# true lets Stoa add training / reflection blocks to your calendar.
GOOGLE_CALENDAR_WRITE=false
